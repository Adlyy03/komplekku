{
  "expo": {
    "name": "komplekku",
    "slug": "komplekku",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "komplekku",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.komplekku.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.komplekku.app",
      "adaptiveIcon": {
        "backgroundColor": "#F1F6F4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#28624F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan Komplekku mengakses galeri foto untuk mengunggah bukti pembayaran iuran dan foto produk.",
          "cameraPermission": "Izinkan Komplekku mengakses kamera untuk mengambil foto bukti pembayaran iuran atau dokumen domisili."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#28624F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
